# TON618 billing reference
# Tebex is the only public payment provider.

# Public web configuration
VITE_TEBEX_STORE_URL=https://store.ton618bot.xyz/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key

# The signed webhook runs in ton618-bot, not in a browser or Supabase Edge
# Function. Define these values only in the bot's production environment:
#
# TEBEX_SECRET_KEY=replace_with_tebex_webhook_secret
# TEBEX_PUBLIC_TOKEN=replace_with_tebex_public_account_token
# TEBEX_ALLOWED_PKG_IDS=7434172,7434175,7434185
# TEBEX_PACKAGE_TIER_MAP={"7434172":"pro_monthly","7434175":"pro_yearly","7434185":"lifetime"}
#
# Never commit the real webhook secret.

# Apply before enabling public purchases:
# supabase/migrations/20260612000000_add_tebex_provider_and_entitlements.sql
